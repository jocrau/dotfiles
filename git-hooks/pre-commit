#!/bin/sh
# This repo is public: refuse commits whose staged changes contain secrets.
# Enabled by install.sh (git config core.hooksPath git-hooks).
# Bypass for a known false positive with: git commit --no-verify
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; install it with 'brew install gitleaks'" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
