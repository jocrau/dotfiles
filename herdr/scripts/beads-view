#!/usr/bin/env python3
"""beads-view: `bd list --watch`, made interactive with fzf.

Shows the current repo's beads as bd's own tree (open beads by default) with a
detail pane for the selected bead. Keys: Enter focuses a bead (its subtree
becomes the view), Backspace on an empty query goes back up, Tab folds or
unfolds a bead's children, 1-9 (with an empty filter) folds the tree to that
many levels and 0 unfolds it all, Ctrl-L edits the bead's labels, Ctrl-A
switches between open and all beads, typing filters, Esc quits. The view
refreshes by itself when beads change.

IDs are shown relative to their parent (`proj-erd.12.18` under `proj-erd.12`
shows as `.18`; at the top the repo's issue prefix is dropped). Rows end with
the bead's labels, leaving out labels that every row in the view shares.

Optional settings in ~/.config/beads-view/config.json (all keys optional):
  "row_labels":       glob patterns of labels shown in rows      (default ["*"])
  "readonly_labels":  glob patterns Ctrl-L never offers or changes (default [])
  "suggested_labels": extra labels Ctrl-L offers                  (default [])

Focus, folds and the open/all choice are remembered per repo in
~/.local/state/beads-view/. Subcommands (render, header, toggle, level, focus,
up, all, show, labels, watch) are called by fzf's key bindings; run without
arguments to start the view. Needs python3, bd and fzf (0.60 or later).
"""
import fnmatch
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import textwrap
import time
import urllib.request

# Key bindings may run with a minimal PATH (e.g. from a terminal multiplexer),
# so also look in the usual install locations, and pass that PATH on.
_EXTRA_PATH = ["/opt/homebrew/bin", "/usr/local/bin", os.path.expanduser("~/.local/bin"),
               os.path.expanduser("~/go/bin")]
os.environ["PATH"] = os.pathsep.join(
    dict.fromkeys(os.environ.get("PATH", "").split(os.pathsep) + _EXTRA_PATH))
BD, FZF = shutil.which("bd"), shutil.which("fzf")
SELF = os.path.realpath(__file__)
PY = sys.executable
REFRESH_SECONDS = 2

ANSI = re.compile(r"\x1b\[[0-9;]*m")
# A bead line in `bd list`: tree prefix, status symbol, ID.
BEAD = re.compile(r"^(?P<prefix>(?:│   |    )*(?:├── |└── )?)(?P<sym>[○◐●✓❄]) (?P<id>\S+)")
DIM, BOLD, ACCENT, RESET = "\x1b[2m", "\x1b[1m", "\x1b[36m", "\x1b[0m"
COLOR_ENV = dict(os.environ, CLICOLOR_FORCE="1")
STATUS_SYMBOL = {"open": "○", "in_progress": "◐", "blocked": "●", "closed": "✓", "deferred": "❄"}


def repo_root():
    """The nearest folder with a .beads directory, else the current folder."""
    here = os.getcwd()
    path = here
    while path != os.path.dirname(path):
        if os.path.isdir(os.path.join(path, ".beads")):
            return path
        path = os.path.dirname(path)
    return here


ROOT = repo_root()
STATE_FILE = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "beads-view",
    hashlib.sha1(ROOT.encode()).hexdigest()[:12] + ".json")
CONFIG_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "beads-view", "config.json")


def config():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    return {
        "row_labels": cfg.get("row_labels", ["*"]),
        "readonly_labels": cfg.get("readonly_labels", []),
        "suggested_labels": cfg.get("suggested_labels", []),
    }


def matches(label, patterns):
    return any(fnmatch.fnmatchcase(label, p) for p in patterns)


def load():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    state.setdefault("stack", [])      # focused bead IDs, outermost first
    state.setdefault("collapsed", [])  # bead IDs whose children are folded
    state.setdefault("all", False)     # include closed beads
    return state


def save(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f)
    os.replace(tmp, STATE_FILE)


def bd(*args):
    out = subprocess.run([BD, *args], cwd=ROOT, env=COLOR_ENV,
                         capture_output=True, text=True, timeout=20)
    return out.stdout


def issue_prefix():
    return bd("config", "get", "issue_prefix").strip()


def short_id(bead_id, parent, prefix):
    """The ID relative to its parent: `.18` for `proj-erd.12.18` under
    `proj-erd.12`, `-sessionbd` for `x-r7-sessionbd` under `x-r7`. Without such
    a parent, the repo's issue prefix is dropped: `erd.12.18`."""
    for sep in (".", "-"):
        if parent and bead_id.startswith(parent + sep):
            return bead_id[len(parent):]
    if prefix and bead_id.startswith(prefix + "-"):
        return bead_id[len(prefix) + 1:]
    return bead_id


def has_children(bead_id, state):
    """Whether the bead has children in the current open/all view."""
    probe = dict(state, stack=state["stack"] + [bead_id])
    return any(depth > 0 for depth, _, _ in beads(probe))


def list_args(state):
    args = ["list", "--limit", "0"]
    if state["all"]:
        args.append("--all")
    if state["stack"]:
        args += ["--parent", state["stack"][-1]]
    return args


def beads(state):
    """(depth, id, line) for every bead line bd prints for the current view."""
    rows = []
    for line in bd(*list_args(state)).splitlines():
        m = BEAD.match(ANSI.sub("", line))
        if m:
            rows.append((len(m.group("prefix")) // 4, m.group("id"), line))
    return rows


def labels_by_id(state):
    """{bead id: [labels]} for the current view."""
    try:
        issues = json.loads(bd(*list_args(state), "--json") or "[]")
    except ValueError:
        return {}
    return {i["id"]: sorted(i.get("labels") or []) for i in issues if "id" in i}


def render(state):
    """fzf input: `ID<TAB>line`, with short IDs, fold markers and row labels."""
    rows = beads(state)
    # A focused bead with nothing left to show (all children closed, or gone):
    # step back up instead of showing an empty screen.
    while state["stack"] and not rows:
        state["stack"].pop()
        save(state)
        rows = beads(state)
    labels, cfg, prefix = labels_by_id(state), config(), issue_prefix()
    collapsed = set(state["collapsed"])
    shared = set.intersection(*(set(labels.get(r[1], [])) for r in rows)) if len(rows) > 1 else set()
    out, hide_below, parents = [], None, []
    for i, (depth, bead_id, line) in enumerate(rows):
        parents[depth:] = [bead_id]
        if hide_below is not None:
            if depth > hide_below:
                continue
            hide_below = None
        has_children = i + 1 < len(rows) and rows[i + 1][0] > depth
        sym = BEAD.match(ANSI.sub("", line)).group("sym")
        suffix = ""
        if has_children and bead_id in collapsed:
            hidden = 0
            for later_depth, _, _ in rows[i + 1:]:
                if later_depth <= depth:
                    break
                hidden += 1
            marker, suffix, hide_below = "▸ ", f"  {DIM}+{hidden}{RESET}", depth
        elif has_children:
            marker = "▾ "
        else:
            marker = "  "
        parent = parents[depth - 1] if depth else ""
        line = line.replace(sym, f"{DIM}{marker}{RESET}{sym}", 1)
        line = line.replace(bead_id, short_id(bead_id, parent, prefix), 1)
        tags = [f"#{l}" for l in labels.get(bead_id, [])
                if l not in shared and matches(l, cfg["row_labels"])]
        if tags:
            suffix += f"  {DIM}{' '.join(tags)}{RESET}"
        out.append(f"{bead_id}\t{line}{suffix}")
    return "\n".join(out)


def header(state):
    prefix = issue_prefix()
    trail, parent = [], ""
    for bead_id in state["stack"]:
        trail.append(short_id(bead_id, parent, prefix))
        parent = bead_id
    where = " › ".join([os.path.basename(ROOT)] + trail)
    return f"{BOLD}{where}{RESET}  {DIM}{'all' if state['all'] else 'open'}{RESET}"


BLOCK_LINE = re.compile(r"\s*([-*+]\s|\d+[.)]\s|\||#|>|```)")  # list, table, heading, quote, code
DATED_LINE = re.compile(r"\s*\d{4}-\d{2}-\d{2}\b")              # a dated log entry
HEADING_LINE = re.compile(r"^[A-Z][A-Z0-9 /&-]{1,40}:?$")         # a short ALL-CAPS line


def reflow(text):
    """Join hard-wrapped lines into paragraphs; keep lists, tables, code.

    A dated line (`2026-10-04 …`) starts a new paragraph, so log-style notes
    stay one entry per paragraph; a short ALL-CAPS line becomes a heading."""
    out, in_code = [], False

    def new_paragraph():
        if out and out[-1].strip():
            out.append("")

    for raw in (text or "").splitlines():
        line = raw.rstrip()
        if line.strip().startswith("```"):
            in_code = not in_code
            out.append(f"{DIM}{line}{RESET}")
            continue
        if in_code:
            out.append(line)
            continue
        if not line.strip():
            new_paragraph()
            continue
        if HEADING_LINE.match(line.strip()):
            new_paragraph()
            out.append(f"{BOLD}{line.strip().rstrip(':')}{RESET}")
            continue
        if DATED_LINE.match(line):
            new_paragraph()
            out.append(line.strip())
            continue
        prev = out[-1] if out else ""
        if prev.strip() and not BLOCK_LINE.match(line) and not prev.startswith((BOLD, DIM)) \
                and not prev.strip().startswith(("|", "#")):
            out[-1] = prev + " " + line.strip()
        else:
            out.append(line)
    return "\n".join(out).strip()


def detail(bead_id):
    """The preview pane: a compact header, then the text as paragraphs."""
    try:
        issue = json.loads(bd("show", bead_id, "--json") or "[]")
        issue = issue[0] if isinstance(issue, list) else issue
    except (ValueError, IndexError):
        return bd("show", bead_id)
    status = issue.get("status", "")
    deps = issue.get("dependencies") or []
    # Title first; then one dim line of facts with the full ID (this pane shows
    # one bead out of the tree's context), the parent with its title, labels.
    lines = [
        f"{BOLD}{issue.get('title', '')}{RESET}",
        f"{DIM}{bead_id} · {RESET}{STATUS_SYMBOL.get(status, '')} {status.replace('_', ' ')}"
        f"{DIM} · P{issue.get('priority', '')} · {issue.get('issue_type', '')}{RESET}",
    ]
    parent = next((d for d in deps if d.get("dependency_type") == "parent-child"), None)
    if issue.get("parent"):
        title = parent.get("title", "") if parent and parent.get("id") == issue["parent"] else ""
        lines.append(f"{DIM}↑ {issue['parent']}  {title}{RESET}")
    for dep in deps:
        if dep.get("dependency_type") not in ("parent-child", None):
            lines.append(f"{DIM}{dep['dependency_type'].replace('-', ' ')}: {dep['id']}  "
                         f"{STATUS_SYMBOL.get(dep.get('status', ''), '')} {dep.get('title', '')}{RESET}")
    if issue.get("labels"):
        lines.append(DIM + "  ".join(f"#{l}" for l in sorted(issue["labels"])) + RESET)
    for key, heading in (("description", ""), ("design", "Design"),
                         ("acceptance_criteria", "Acceptance"), ("notes", "Notes")):
        text = reflow(issue.get(key, ""))
        if text:
            lines.append("")
            if heading:
                lines += [f"{BOLD}{ACCENT}{heading}{RESET}"]
            lines.append(text)
    return "\n".join(lines) + "\n"


def edit_labels(bead_id):
    """Multi-select the bead's labels in fzf; apply the difference with bd."""
    cfg = config()
    try:
        issue = json.loads(bd("show", bead_id, "--json") or "[]")
        issue = issue[0] if isinstance(issue, list) else issue
        current = sorted(issue.get("labels") or [])
        used = [entry["label"] for entry in json.loads(bd("label", "list-all", "--json") or "[]")]
    except (ValueError, KeyError, IndexError):
        return
    readonly = cfg["readonly_labels"]

    def grouped(labels):  # plain labels first, then by namespace (`owner:…`)
        return sorted(labels, key=lambda l: (":" in l, l.split(":", 1)[0] if ":" in l else "", l))

    def shown(label):  # the namespace dimmed, so each group reads as a block
        ns, sep, rest = label.partition(":")
        return f"{DIM}{ns}:{RESET}{rest}" if sep else label

    editable = grouped(l for l in current if not matches(l, readonly))
    others = grouped(set(cfg["suggested_labels"] + used) - set(editable) - {""}
                     - {l for l in cfg["suggested_labels"] + used if matches(l, readonly)})
    choices = editable + others
    preselect = "+".join(f"pos({i})+select" for i in range(1, len(editable) + 1))
    args = [
        FZF, "--multi", "--ansi", "--layout=reverse", "--no-sort", "--print-query",
        "--no-separator", "--no-scrollbar", "--gutter= ", "--marker=✓ ", "--info=hidden",
        "--footer-border=none",
        f"--prompt={bead_id} labels › ",
        "--footer=tab toggles · type a new label · enter applies · esc cancels",
        # load, not start: the rows must be in before they can be ticked.
        f"--bind=load:{preselect}+first" if preselect else "--bind=load:first",
        # With nothing ticked fzf returns the row under the cursor; mark that
        # case so unticking everything removes every label. (transform: form,
        # because the command itself contains parentheses.)
        '--bind=enter:transform:[ "$FZF_SELECT_COUNT" -eq 0 ] && echo "print(<none>)+accept" || echo accept',
    ]
    proc = subprocess.run(args, input="\n".join(shown(c) for c in choices), text=True,
                          stdout=subprocess.PIPE)
    if proc.returncode not in (0, 1):  # Esc or an error: change nothing
        return
    lines = proc.stdout.split("\n")
    query, picked = lines[0].strip(), [ANSI.sub("", l) for l in lines[1:] if l]
    wanted = set() if "<none>" in picked else set(picked)
    # The typed text adds a label when it names one exactly or is new; text
    # that only narrows the list (part of an existing label) adds nothing.
    if query and not matches(query, readonly):
        if query in choices or not any(query.lower() in c.lower() for c in choices):
            wanted.add(query)
    add, remove = sorted(wanted - set(editable)), sorted(set(editable) - wanted)
    if not add and not remove:
        return
    cmd = ["update", bead_id]
    for label in add:
        cmd += ["--add-label", label]
    for label in remove:
        cmd += ["--remove-label", label]
    subprocess.run([BD, *cmd], cwd=ROOT, capture_output=True, text=True, timeout=20)


def watch():
    """Reload fzf (via --listen) whenever the rendered view changes."""
    url = f"http://127.0.0.1:{os.environ['FZF_PORT']}"
    last = None
    while True:
        time.sleep(REFRESH_SECONDS)
        try:  # exit as soon as fzf is gone, even when nothing changes
            urllib.request.urlopen(url, timeout=3).read()
        except Exception:
            return
        try:
            view = render(load())
        except Exception:
            continue
        digest = hashlib.sha1(view.encode()).hexdigest()
        if digest == last:
            continue
        # The header too: render may have stepped up out of an emptied focus.
        action = f"transform-header({RUN} header)+reload({RUN} render)+refresh-preview"
        try:
            urllib.request.urlopen(urllib.request.Request(url, data=action.encode(), method="POST"), timeout=3)
        except Exception:
            return  # fzf is gone
        last = digest


RUN = f"{PY} {SELF}"  # how fzf's bindings call this script


def view():
    # The header changes before the (asynchronous) reload; after it, fzf drops it.
    reload = f"transform-header({RUN} header)+reload({RUN} render)"
    args = [
        FZF, "--ansi", "--layout=reverse", "--no-sort", "--track",
        "--delimiter=\t", "--with-nth=2..", "--id-nth=1", "--listen",
        "--no-separator", "--no-scrollbar", "--gutter= ", "--info=hidden", "--prompt=› ",
        "--footer-border=none", "--ellipsis=…",
        "--footer=enter focus · ⌫ up · tab fold · 1-9 levels · 0 unfold · ctrl-l labels · ctrl-a open/all · esc quit",
        f"--preview={RUN} show {{1}}", "--preview-window=right,50%,wrap-word,border-left,noinfo",
        "--preview-wrap-sign=",
        f"--bind=start:execute-silent({RUN} watch >/dev/null 2>&1 &)+transform-header({RUN} header)",
        f"--bind=tab:execute-silent({RUN} toggle {{1}})+reload({RUN} render)",
        f"--bind=enter:execute-silent({RUN} focus {{1}})+{reload}+first",
        f"--bind=double-click:execute-silent({RUN} focus {{1}})+{reload}+first",
        f"--bind=backward-eof:execute-silent({RUN} up)+{reload}",
        f"--bind=ctrl-a:execute-silent({RUN} all)+{reload}",
        f"--bind=ctrl-l:execute({RUN} labels {{1}})+reload({RUN} render)+refresh-preview",
        "--bind=esc:abort",
    ]
    # Digits fold to a level while the filter is empty, and are typed otherwise
    # (so `12` still finds `.12`). transform: form, as the action has parentheses.
    for n in range(10):
        args.append(f'--bind={n}:transform:[ -z {{q}} ] && echo "execute-silent({RUN} level {n})'
                    f'+reload({RUN} render)" || echo "put({n})"')
    proc = subprocess.run(args, input=render(load()), text=True, cwd=ROOT)
    sys.exit(0 if proc.returncode in (0, 1, 130) else proc.returncode)


def main(argv):
    missing = [name for name, path in (("bd", BD), ("fzf", FZF)) if not path]
    if missing:
        sys.exit(f"beads-view: needs {' and '.join(missing)} on PATH")
    if not argv:
        return view()
    cmd, rest = argv[0], argv[1:]
    state = load()
    if cmd == "render":
        print(render(state))
    elif cmd == "header":
        print(header(state))
    elif cmd == "show" and rest and rest[0]:
        sys.stdout.write(detail(rest[0]))
    elif cmd == "toggle" and rest:
        state["collapsed"] = sorted(set(state["collapsed"]) ^ {rest[0]})
        save(state)
    elif cmd == "level" and rest and rest[0].isdigit():
        # Show N levels of the current view (level 1 = its top rows): fold every
        # bead at level N or deeper that has children; 0 unfolds the view.
        # Folds of beads outside the view are kept.
        n, rows = int(rest[0]), beads(state)
        in_view = {bead_id for _, bead_id, _ in rows}
        parents = {rows[i][1] for i in range(len(rows) - 1) if rows[i + 1][0] > rows[i][0]}
        folded = {bead_id for depth, bead_id, _ in rows if n and depth >= n - 1 and bead_id in parents}
        state["collapsed"] = sorted((set(state["collapsed"]) - in_view) | folded)
        save(state)
    elif cmd == "focus" and rest:
        # Only a bead with children becomes the view; a leaf (or an empty
        # list's blank row) would leave an empty screen.
        if not rest[0] or not has_children(rest[0], state):
            return
        if not state["stack"] or state["stack"][-1] != rest[0]:
            state["stack"].append(rest[0])
        # A focused bead shows its children, even if it was folded.
        state["collapsed"] = [b for b in state["collapsed"] if b != rest[0]]
        save(state)
    elif cmd == "up":
        if state["stack"]:
            state["stack"].pop()
        save(state)
    elif cmd == "all":
        state["all"] = not state["all"]
        save(state)
    elif cmd == "labels" and rest:
        edit_labels(rest[0])
    elif cmd == "watch":
        watch()
    else:
        sys.exit(f"beads-view: unknown command {cmd!r}")


if __name__ == "__main__":
    main(sys.argv[1:])
