#!/usr/bin/env python3
"""beads-view: `bd list --watch`, made interactive with fzf.

Shows the current repo's beads as bd's own tree (open beads by default); Enter
shows or hides a detail pane for the selected bead. Keys (arrows and digits
while the filter is empty): Right focuses a bead (its subtree becomes the
view), or on a bead without children shows its details; Left moves to the
parent, and on a top row of a focused view goes back up (as does Backspace),
so repeated Lefts climb the tree. Tab folds or unfolds a bead's
children, 1-9 folds the tree to that many levels and 0 unfolds it all, Ctrl-L
edits the bead's labels, Ctrl-A switches between open and all beads, typing
filters, Esc quits. The view refreshes by itself when beads change.

Right on a bead whose details show (or Ctrl-E anywhere) edits it in place: in
the detail pane itself, the tree staying beside it, with the title, status,
priority, labels and text editable. Tab, Up and Down move between fields (a click too); Left/Right or
a digit/letter changes status and priority; Ctrl-E hands a text to $EDITOR,
Ctrl-L picks labels; Ctrl-S saves with one `bd update`, Esc cancels.

IDs are shown relative to their parent (`proj-erd.12.18` under `proj-erd.12`
shows as `.18`; at the top the repo's issue prefix is dropped). Rows end with
the bead's labels, leaving out labels that every row in the view shares.

Optional settings in ~/.config/beads-view/config.json (all keys optional):
  "row_labels":       glob patterns of labels shown in rows      (default ["*"])
  "readonly_labels":  glob patterns Ctrl-L never offers or changes (default [])
  "suggested_labels": extra labels Ctrl-L offers                  (default [])

Focus, folds and the open/all choice are remembered per repo in
~/.local/state/beads-view/; bd's output is cached in ~/.cache/beads-view/ so
keys respond without waiting for bd (safe to delete). Subcommands (render, header, toggle, level, focus,
up, all, show, labels, edit, watch) are called by fzf's key bindings; run without
arguments to start the view. Needs python3, bd and fzf (0.60 or later).
"""
import fnmatch
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
import threading
import time

# Key bindings may run with a minimal PATH (e.g. from a terminal multiplexer),
# so also look in the usual install locations, and pass that PATH on.
_EXTRA_PATH = ["/opt/homebrew/bin", "/usr/local/bin", os.path.expanduser("~/.local/bin"),
               os.path.expanduser("~/go/bin")]
os.environ["PATH"] = os.pathsep.join(
    dict.fromkeys(os.environ.get("PATH", "").split(os.pathsep) + _EXTRA_PATH))
BD, FZF = shutil.which("bd"), shutil.which("fzf")
SELF = os.path.realpath(__file__)
PY = sys.executable
REFRESH_SECONDS = 2

ANSI = re.compile(r"\x1b\[[0-9;]*m")
# A bead line in `bd list`: tree prefix, status symbol, ID.
BEAD = re.compile(r"^(?P<prefix>(?:│   |    )*(?:├── |└── )?)(?P<sym>[○◐●✓❄]) (?P<id>\S+)")
DIM, BOLD, ACCENT, RESET = "\x1b[2m", "\x1b[1m", "\x1b[36m", "\x1b[0m"
COLOR_ENV = dict(os.environ, CLICOLOR_FORCE="1")
STATUS_SYMBOL = {"open": "○", "in_progress": "◐", "blocked": "●", "closed": "✓", "deferred": "❄"}
# The terminal's own palette, so the theme decides the actual colours.
STATUS_COLOR = {"in_progress": "\x1b[33m", "blocked": "\x1b[31m", "closed": "\x1b[32m", "deferred": "\x1b[34m"}
PRIORITY_COLOR = {0: "\x1b[1;31m", 1: "\x1b[33m", 3: DIM, 4: DIM}


def repo_root():
    """The nearest folder with a .beads directory, else the current folder."""
    here = os.getcwd()
    path = here
    while path != os.path.dirname(path):
        if os.path.isdir(os.path.join(path, ".beads")):
            return path
        path = os.path.dirname(path)
    return here


ROOT = repo_root()
REPO_KEY = hashlib.sha1(ROOT.encode()).hexdigest()[:12]
STATE_FILE = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "beads-view",
    REPO_KEY + ".json")
# bd takes ~0.1 s per call, too slow for every key press: the views and the
# detail panes are cached here, and the watcher keeps them fresh.
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "beads-view", REPO_KEY)
DETAIL_DIR = os.path.join(CACHE_DIR, "details")
CONFIG_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "beads-view", "config.json")


def config():
    try:
        with open(CONFIG_FILE, encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    return {
        "row_labels": cfg.get("row_labels", ["*"]),
        "readonly_labels": cfg.get("readonly_labels", []),
        "suggested_labels": cfg.get("suggested_labels", []),
    }


def matches(label, patterns):
    return any(fnmatch.fnmatchcase(label, p) for p in patterns)


def load():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    state.setdefault("stack", [])      # focused bead IDs, outermost first
    state.setdefault("collapsed", [])  # bead IDs whose children are folded
    state.setdefault("all", False)     # include closed beads
    return state


def write(path, text):
    """Write atomically: readers (fzf, a parallel call) never see half a file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def save(state):
    write(STATE_FILE, json.dumps(state))


def bd(*args):
    out = subprocess.run([BD, *args], cwd=ROOT, env=COLOR_ENV,
                         capture_output=True, text=True, timeout=20)
    return out.stdout


def issue_prefix():
    path = os.path.join(CACHE_DIR, "prefix")
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        prefix = bd("config", "get", "issue_prefix").strip()
        write(path, prefix)
        return prefix


def short_id(bead_id, parent, prefix, ancestors=()):
    """The ID relative to its parent: `.18` for `proj-erd.12.18` under
    `proj-erd.12`, `-sessionbd` for `x-r7-sessionbd` under `x-r7`. An ID that
    doesn't extend its parent's is shortened relative to the outermost
    ancestor it extends (`-r7-pilot` for `x-r7-pilot` under `x-onebead` under
    `x`), so it doesn't read as the parent's own child. Otherwise the repo's
    issue prefix is dropped: `erd.12.18`."""
    for sep in (".", "-"):
        if parent and bead_id.startswith(parent + sep):
            return bead_id[len(parent):]
    for ancestor in ancestors:  # outermost first
        if any(bead_id.startswith(ancestor + sep) for sep in (".", "-")):
            return bead_id[len(ancestor):]
    if prefix and bead_id.startswith(prefix + "-"):
        return bead_id[len(prefix) + 1:]
    return bead_id


def has_children(bead_id, state):
    """Whether the bead has children in the current open/all view."""
    probe = dict(state, stack=state["stack"] + [bead_id])
    return any(depth > 0 for depth, _, _ in beads(probe))


def list_args(state):
    args = ["list", "--limit", "0"]
    if state["all"]:
        args.append("--all")
    if state["stack"]:
        args += ["--parent", state["stack"][-1]]
    return args


def fetch(state, fresh=False):
    """bd's tree text and JSON for the current view: from the cache unless
    `fresh` or not cached yet (the watcher refreshes it every few seconds)."""
    args = list_args(state)
    path = os.path.join(CACHE_DIR, "views", hashlib.sha1(" ".join(args).encode()).hexdigest()[:12] + ".json")
    if not fresh:
        try:
            with open(path, encoding="utf-8") as f:
                cached = json.load(f)
            return cached["text"], cached["issues"]
        except (OSError, ValueError, KeyError):
            pass
    # The JSON without --parent: with it, bd lists only the direct children,
    # while the tree shows the whole subtree.
    json_args = list_args(dict(state, stack=[])) + ["--json"]
    out = {}
    calls = [threading.Thread(target=lambda: out.update(text=bd(*args))),
             threading.Thread(target=lambda: out.update(json=bd(*json_args)))]
    for call in calls:
        call.start()
    for call in calls:
        call.join()
    try:
        issues = [i for i in json.loads(out.get("json") or "[]") if "id" in i]
    except ValueError:
        issues = []
    text = out.get("text", "")
    write(path, json.dumps({"text": text, "issues": issues}))
    return text, issues


def beads(state, fresh=False):
    """(depth, id, line) for every bead line bd prints for the current view."""
    rows = []
    for line in fetch(state, fresh)[0].splitlines():
        m = BEAD.match(ANSI.sub("", line))
        if m:
            rows.append((len(m.group("prefix")) // 4, m.group("id"), line))
    return rows


def stamp(issue, issues):
    """Changes whenever the bead's detail pane would: names its cached copy.

    Not just updated_at: bd leaves that alone when labels change, or when a
    blocker or the parent changes status or title, which the pane also shows.
    A related bead missing from `issues` (closed, in the open view) counts too."""
    related = [(d.get("depends_on_id"), issues.get(d.get("depends_on_id"), {}).get("status"),
                issues.get(d.get("depends_on_id"), {}).get("title"))
               for d in issue.get("dependencies") or []]
    return hashlib.sha1(json.dumps([issue, related], sort_keys=True).encode()).hexdigest()[:12]


def detail_path(bead_id, bead_stamp="", width=""):
    """The cached pane for a bead version at a pane width; without a stamp,
    the prefix shared by all of the bead's cached panes."""
    name = f"{bead_id.replace('/', '_')}@" + (f"{bead_stamp}@{width}" if bead_stamp else "")
    return os.path.join(DETAIL_DIR, name)


def preview_width():
    """fzf's preview width; outside fzf (the watcher) the last one seen."""
    path = os.path.join(CACHE_DIR, "width")
    width = os.environ.get("FZF_PREVIEW_COLUMNS", "")
    if width.isdigit():
        try:
            with open(path, encoding="utf-8") as f:
                seen = f.read()
        except OSError:
            seen = ""
        if seen != width:
            write(path, width)
        return int(width)
    try:
        with open(path, encoding="utf-8") as f:
            return int(f.read())
    except (OSError, ValueError):
        return 80


def render(state, fresh=False):
    """fzf input: `ID<TAB>stamp<TAB>parent row<TAB>has children<TAB>line`, with
    short IDs, fold markers and row labels. The parent row is the parent's
    position in this list (empty for a top row), for Left to jump to."""
    rows = beads(state, fresh)
    # A focused bead with nothing left to show (all children closed, or gone):
    # step back up instead of showing an empty screen.
    while state["stack"] and not rows:
        state["stack"].pop()
        save(state)
        rows = beads(state, fresh)
    issues = {i["id"]: i for i in fetch(state)[1]}
    labels = {bead_id: sorted(i.get("labels") or []) for bead_id, i in issues.items()}
    cfg, prefix = config(), issue_prefix()
    collapsed = set(state["collapsed"])
    shared = set.intersection(*(set(labels.get(r[1], [])) for r in rows)) if len(rows) > 1 else set()
    # Short IDs, padded so the priorities and titles of the visible rows at one
    # depth start in one column, across subtrees (shallower rows, often epics,
    # stay further left). An ID that can't be shortened (it doesn't extend its
    # parent's ID) doesn't set the column: it just overflows. A row's ID ends
    # at its depth's tree indent (4 per level), the fold marker and status
    # symbol (4), plus the short ID.
    shorts, ends, parents, hide_below = [], {}, [], None
    for i, (depth, bead_id, _) in enumerate(rows):
        parents[depth:] = [bead_id]
        parent = parents[depth - 1] if depth else ""
        shorts.append((parent, short_id(bead_id, parent, prefix, parents[:max(depth - 1, 0)])))
        if hide_below is not None and depth > hide_below:
            continue
        hide_below = None
        if bead_id in collapsed and i + 1 < len(rows) and rows[i + 1][0] > depth:
            hide_below = depth
        short = shorts[-1][1]
        ends.setdefault(depth, []).append((short != bead_id, depth * 4 + 4 + len(short)))
    column = {depth: max([end for fits, end in group if fits] or [end for _, end in group])
              for depth, group in ends.items()}
    out, hide_below, position = [], None, {}
    for i, (depth, bead_id, line) in enumerate(rows):
        if hide_below is not None:
            if depth > hide_below:
                continue
            hide_below = None
        has_children = i + 1 < len(rows) and rows[i + 1][0] > depth
        sym = BEAD.match(ANSI.sub("", line)).group("sym")
        suffix = ""
        if has_children and bead_id in collapsed:
            hidden = 0
            for later_depth, _, _ in rows[i + 1:]:
                if later_depth <= depth:
                    break
                hidden += 1
            marker, suffix, hide_below = "▸ ", f"  {DIM}+{hidden}{RESET}", depth
        elif has_children:
            marker = "▾ "
        else:
            marker = "  "
        parent, short = shorts[i]
        # The marker goes before bd's colour code for the symbol, so its
        # reset doesn't strip the status colour.
        line = re.sub(rf"((?:\x1b\[[0-9;]*m)*){sym}", lambda m: f"{DIM}{marker}{RESET}{m.group(1)}{sym}",
                      line, count=1)
        line = line.replace(bead_id, short.ljust(column.get(depth, 0) - depth * 4 - 4), 1)
        tags = [f"#{l}" for l in labels.get(bead_id, [])
                if l not in shared and matches(l, cfg["row_labels"])]
        if tags:
            suffix += f"  {DIM}{' '.join(tags)}{RESET}"
        position[bead_id] = len(out) + 1
        out.append(f"{bead_id}\t{stamp(issues.get(bead_id, {}), issues)}\t{position.get(parent, '')}"
                   f"\t{int(has_children)}\t{line}{suffix}")
    return "\n".join(out)


def header(state):
    prefix = issue_prefix()
    trail, parent = [], ""
    for bead_id in state["stack"]:
        trail.append(short_id(bead_id, parent, prefix))
        parent = bead_id
    where = " › ".join([os.path.basename(ROOT)] + trail)
    return f"{BOLD}{where}{RESET}  {DIM}{'all' if state['all'] else 'open'}{RESET}"


BLOCK_LINE = re.compile(r"\s*([-*+]\s|\d+[.)]\s|\||#|>|```)")  # list, table, heading, quote, code
DATED_LINE = re.compile(r"\s*\d{4}-\d{2}-\d{2}\b")              # a dated log entry
HEADING_LINE = re.compile(r"^[A-Z][A-Z0-9 /&-]{1,40}:?$")         # a short ALL-CAPS line


def reflow(text):
    """Join hard-wrapped lines into paragraphs; keep lists, tables, code.

    A dated line (`2026-10-04 …`) starts a new paragraph, so log-style notes
    stay one entry per paragraph; a short ALL-CAPS line becomes a heading."""
    out, in_code = [], False

    def new_paragraph():
        if out and out[-1].strip():
            out.append("")

    for raw in (text or "").splitlines():
        line = raw.rstrip()
        if line.strip().startswith("```"):
            in_code = not in_code
            out.append(f"{DIM}{line}{RESET}")
            continue
        if in_code:
            out.append(line)
            continue
        if not line.strip():
            new_paragraph()
            continue
        if HEADING_LINE.match(line.strip()):
            new_paragraph()
            out.append(f"{BOLD}{line.strip().rstrip(':')}{RESET}")
            continue
        if DATED_LINE.match(line):
            new_paragraph()
            out.append(line.strip())
            continue
        prev = out[-1] if out else ""
        if prev.strip() and not BLOCK_LINE.match(line) and not prev.startswith((BOLD, DIM)) \
                and not prev.strip().startswith(("|", "#")):
            out[-1] = prev + " " + line.strip()
        else:
            out.append(line)
    return "\n".join(out).strip()


KEY_WIDTH = 12  # the header's label column


def fit(text, room):
    """One line of at most `room` characters."""
    return text if len(text) <= room else text[:max(room - 1, 1)].rstrip() + "…"


TEXT_SECTIONS = (("description", ""), ("design", "Design"),
                 ("acceptance_criteria", "Acceptance"), ("notes", "Notes"))


def show_issue(bead_id):
    """`bd show` as a dict, or None. Only the bead itself: for an ID that no
    longer exists, bd answers with a bead whose ID starts with it."""
    try:
        issue = json.loads(bd("show", bead_id, "--json") or "[]")
        issue = issue[0] if isinstance(issue, list) else issue
    except (ValueError, IndexError):
        return None
    return issue if isinstance(issue, dict) and issue.get("id") == bead_id else None


def status_text(status):
    return f"{STATUS_COLOR.get(status, '')}{STATUS_SYMBOL.get(status, '')} {status.replace('_', ' ')}{RESET}"


def priority_text(priority):
    return f"{PRIORITY_COLOR.get(priority, '')}P{priority}{RESET}"


def ref(dep, room, prefix):
    """Another bead: status, short ID, title; a done one dimmed."""
    status, short = dep.get("status", ""), short_id(dep["id"], "", prefix)
    title = fit(dep.get("title", ""), room - len(short) - 4)
    if status == "closed":
        return f"{DIM}✓ {short}  {title}{RESET}"
    return f"{STATUS_COLOR.get(status, '')}{STATUS_SYMBOL.get(status, '')}{RESET} {BOLD}{short}{RESET}  {title}"


def relation_rows(issue, room, prefix):
    """(key, value) rows for the parent and the other related beads; the key
    only on a group's first row. Open blockers first: they are what keeps
    the bead from starting."""
    deps, rows = issue.get("dependencies") or [], []
    parent = next((d for d in deps if d.get("dependency_type") == "parent-child"), None)
    if parent:
        rows.append(("parent", ref(parent, room, prefix)))
    groups = {}
    for dep in sorted(deps, key=lambda d: d.get("status") == "closed"):
        kind = dep.get("dependency_type") or ""
        if kind != "parent-child":
            groups.setdefault("blocked by" if kind == "blocks" else kind.replace("-", " "), []).append(dep)
    for key, group in groups.items():
        for i, dep in enumerate(group):
            rows.append((key if i == 0 else "", ref(dep, room, prefix)))
    return rows


def detail(bead_id, width=80):
    """The preview pane: title, a header of labelled facts, then the text."""
    issue = show_issue(bead_id)
    if issue is None:
        return bd("show", bead_id)
    prefix, room = issue_prefix(), max(width - KEY_WIDTH, 20)
    # The full ID under the title: this pane shows one bead out of the tree.
    lines = [f"{BOLD}{issue.get('title', '')}{RESET}", f"{DIM}{bead_id}{RESET}", ""]

    def row(key, value):  # the label only on a group's first line
        lines.append(f"{DIM}{key.ljust(KEY_WIDTH - 1)}{RESET} {value}")

    priority = issue.get("priority")
    facts = [status_text(issue.get("status", "")), priority_text(priority),
             f"{DIM}{issue.get('issue_type', '')}{RESET}"]
    if issue.get("assignee"):
        facts.append(f"@{issue['assignee']}")
    row("status", "   ".join(facts))
    for key, value in relation_rows(issue, room, prefix):
        row(key, value)
    # Labels by namespace, one line each (`owner  jochen`), plain ones first.
    labels = sorted(issue.get("labels") or [])
    by_ns = {}
    for label in labels:
        ns, sep, value = label.partition(":")
        by_ns.setdefault(ns if sep else "", []).append(value if sep else label)
    ns_width = max((len(ns) for ns in by_ns), default=0)
    key = "labels"
    for ns in sorted(by_ns):
        lead = f"{DIM}{ns.ljust(ns_width)}{RESET}  " if ns else ""
        indent = ns_width + 2 if ns else 0
        wrapped = textwrap.wrap("  ".join(by_ns[ns]), max(room - indent, 10), break_on_hyphens=False) or [""]
        for i, part in enumerate(wrapped):
            row(key, (lead if i == 0 else " " * indent) + part)
            key = ""
    for key, heading in TEXT_SECTIONS:
        text = reflow(issue.get(key, ""))
        if text:
            lines.append("")
            if heading:
                lines += [f"{BOLD}{ACCENT}{heading}{RESET}"]
            lines.append(text)
    # Comments last, oldest first, like a log. bd show only counts them.
    if issue.get("comment_count"):
        try:
            comments = json.loads(bd("comments", bead_id, "--json") or "[]") or []
        except ValueError:
            comments = []
        if comments:
            lines += ["", f"{BOLD}{ACCENT}Comments{RESET}"]
            for i, c in enumerate(sorted(comments, key=lambda c: c.get("created_at", ""))):
                when = (c.get("created_at") or "").replace("T", " ")[:16]
                lines += [""] if i else []
                lines += [f"{DIM}{c.get('author', '')} · {when}{RESET}", reflow(c.get("text", ""))]
    return "\n".join(lines) + "\n"


def cached_detail(bead_id, bead_stamp=""):
    """The detail pane, cached under the bead's stamp when one is given."""
    width = preview_width()
    text = detail(bead_id, width)
    if bead_stamp:
        write(detail_path(bead_id, bead_stamp, width), text)
    return text


def forget_detail(bead_id):
    for path in glob.glob(glob.escape(detail_path(bead_id)) + "*"):
        try:
            os.remove(path)
        except OSError:
            pass


def grouped(labels):
    """Plain labels first, then by namespace (`owner:…`)."""
    return sorted(labels, key=lambda l: (":" in l, l.split(":", 1)[0] if ":" in l else "", l))


def edit_labels(bead_id, state):
    """Ctrl-L: pick the bead's labels, apply the difference with bd."""
    issue = show_issue(bead_id)
    if issue is None:
        return
    readonly = config()["readonly_labels"]
    editable = [l for l in issue.get("labels") or [] if not matches(l, readonly)]
    wanted = pick_labels(bead_id, editable, state)
    if wanted is None:
        return
    add, remove = sorted(set(wanted) - set(editable)), sorted(set(editable) - set(wanted))
    if not add and not remove:
        return
    cmd = ["update", bead_id]
    for label in add:
        cmd += ["--add-label", label]
    for label in remove:
        cmd += ["--remove-label", label]
    subprocess.run([BD, *cmd], cwd=ROOT, capture_output=True, text=True, timeout=20)
    forget_detail(bead_id)
    fetch(state, fresh=True)  # so fzf's reload after this reads the cache


def pick_labels(bead_id, current, state):
    """Multi-select labels in fzf, starting from `current` (the editable ones);
    the labels wanted, or None when cancelled.

    Offers the labels in use on the view's beads (open ones in the open view),
    not `bd label list-all`, which also counts closed beads and so keeps
    offering labels long retired; any other label can still be typed."""
    cfg = config()
    used = sorted({l for i in fetch(state)[1] for l in i.get("labels") or []})
    readonly = cfg["readonly_labels"]

    def shown(label):  # the namespace dimmed, so each group reads as a block
        ns, sep, rest = label.partition(":")
        return f"{DIM}{ns}:{RESET}{rest}" if sep else label

    editable = grouped(current)
    others = grouped(set(cfg["suggested_labels"] + used) - set(editable) - {""}
                     - {l for l in cfg["suggested_labels"] + used if matches(l, readonly)})
    choices = editable + others
    preselect = "+".join(f"pos({i})+select" for i in range(1, len(editable) + 1))
    args = [
        FZF, "--multi", "--ansi", "--layout=reverse", "--no-sort", "--print-query",
        "--no-separator", "--no-scrollbar", "--gutter= ", "--marker=✓ ", "--info=hidden",
        "--footer-border=none",
        f"--prompt={bead_id} labels › ",
        "--footer=tab toggles · type a new label · enter applies · esc cancels",
        # load, not start: the rows must be in before they can be ticked.
        f"--bind=load:{preselect}+first" if preselect else "--bind=load:first",
        # With nothing ticked fzf returns the row under the cursor; mark that
        # case so unticking everything removes every label. (transform: form,
        # because the command itself contains parentheses.)
        '--bind=enter:transform:[ "$FZF_SELECT_COUNT" -eq 0 ] && echo "print(<none>)+accept" || echo accept',
    ]
    proc = subprocess.run(args, input="\n".join(shown(c) for c in choices), text=True,
                          stdout=subprocess.PIPE)
    if proc.returncode not in (0, 1):  # Esc or an error: change nothing
        return None
    lines = proc.stdout.split("\n")
    query, picked = lines[0].strip(), [ANSI.sub("", l) for l in lines[1:] if l]
    wanted = set() if "<none>" in picked else set(picked)
    # The typed text adds a label when it names one exactly or is new; text
    # that only narrows the list (part of an existing label) adds nothing.
    if query and not matches(query, readonly):
        if query in choices or not any(query.lower() in c.lower() for c in choices):
            wanted.add(query)
    return grouped(wanted)


# The editor: the detail pane's layout, with the title, status, priority,
# labels and text sections editable in place, drawn into the pane's own
# rectangle. fzf runs inline (--height), so the tree stays on screen beside
# it while the editor runs; plain ANSI and raw keys, as curses would clear
# the screen.
STATUSES = ["open", "in_progress", "blocked", "deferred", "closed"]
EDIT_WIDTH = 100  # outside fzf (no pane to fill), text wraps at most this wide
REVERSE = "\x1b[7m"


def wrap_segments(text, width):
    """Visual lines of `text` at `width`, as (start, end) indexes into it:
    words wrap, newlines break. A wrapped line keeps its trailing space."""
    out, start = [], 0
    for line in text.split("\n"):
        s, n = start, start + len(line)
        while n - s > width:
            cut = text.rfind(" ", s, s + width)
            cut = s + width if cut <= s else cut + 1
            out.append((s, cut))
            s = cut
        out.append((s, n))
        start = n + 1
    return out


def locate(pos, spots):
    """The index of the visual line (in a field's spots) holding the cursor
    at `pos`; at a wrap, the cursor belongs to the next line."""
    for i, (_, _, start, end) in enumerate(spots):
        if start <= pos < end or (pos == end and (i + 1 == len(spots) or spots[i + 1][2] != end)):
            return i
    return len(spots) - 1


def visible_len(text):
    return len(ANSI.sub("", text))


def clip(text, width):
    """`text` (with SGR codes) cut or padded to exactly `width` columns."""
    out, col, pos = [], 0, 0
    for m in list(ANSI.finditer(text)) + [None]:
        end = m.start() if m else len(text)
        chunk = text[pos:end][:max(width - col, 0)]
        out.append(chunk)
        col += len(chunk)
        if m is None:
            break
        out.append(m.group())
        pos = m.end()
    return "".join(out) + RESET + " " * (width - col)


def join_runs(runs):
    """A row from (x, text, sgr) runs, the gaps filled with spaces."""
    line, col = "", 0
    for x, text, sgr in sorted(runs, key=lambda run: run[0]):
        if x > col:
            line, col = line + " " * (x - col), x
        line += f"{sgr}{text}{RESET}" if sgr else text
        col += visible_len(text)
    return line


class Term:
    """Raw keys from, and ANSI to, the terminal.

    Over fzf: while a command runs, fzf leaves its last frame in the
    alternate screen buffer. The editor switches back to it (1047, which
    neither clears it nor touches the saved cursor), so the tree stays in
    view, and draws over the pane; fzf repaints everything after. Once
    another program (an $EDITOR) has used the screen, the frame is gone, and
    the editor blanks the rest. Outside fzf (`beads-view edit ID`) it uses
    the alternate screen, cleared."""

    def __init__(self, over_fzf):
        import select, termios, tty
        self.select, self.termios, self.tty = select.select, termios, tty
        self.fd = os.open("/dev/tty", os.O_RDWR)
        self.saved = termios.tcgetattr(self.fd)
        self.over_fzf, self.pending, self.resumed = over_fzf, b"", False

    def start(self):
        self.tty.setraw(self.fd)
        if self.over_fzf:
            self.write("\x1b[?1047h" + ("\x1b[2J" if self.resumed else ""))
        else:
            self.write("\x1b[?1049h\x1b[2J")
        self.resumed = True
        # Mouse clicks (SGR coordinates), bracketed paste, no line wrap.
        self.write("\x1b[?1000h\x1b[?1006h\x1b[?2004h\x1b[?7l")

    def stop(self):
        self.write("\x1b[?7h\x1b[?2004l\x1b[?1006l\x1b[?1000l\x1b[0m\x1b[?25h"
                   + ("\x1b[?1047l" if self.over_fzf else "\x1b[?1049l"))
        self.termios.tcsetattr(self.fd, self.termios.TCSADRAIN, self.saved)

    def size(self):
        size = os.get_terminal_size(self.fd)
        return size.lines, size.columns

    def write(self, text):
        data = text.encode()
        while data:
            data = data[os.write(self.fd, data):]

    def byte(self):
        while not self.pending:
            self.pending = os.read(self.fd, 4096)
        b, self.pending = self.pending[0], self.pending[1:]
        return b

    def ready(self, timeout):
        return bool(self.pending) or bool(self.select([self.fd], [], [], timeout)[0])

    def key(self):
        """The next key: a character, a name ("up", "btab", "esc", …),
        ("mouse", button, x, y, pressed) or ("paste", text); None for keys
        the editor doesn't use (Alt+letter, …)."""
        b = self.byte()
        if b == 0x1b:
            if not self.ready(0.03):  # nothing follows: Esc itself
                return "esc"
            b = self.byte()
            if b == ord("["):
                return self.csi()
            if b == ord("O"):
                return {"A": "up", "B": "down", "C": "right", "D": "left",
                        "H": "home", "F": "end"}.get(chr(self.byte()))
            return None
        if b < 0x80:
            return chr(b)
        size = 2 if b < 0xe0 else 3 if b < 0xf0 else 4  # UTF-8
        return (bytes([b]) + bytes(self.byte() for _ in range(size - 1))).decode("utf-8", "replace")

    def csi(self):
        seq = ""
        while not seq or not "@" <= seq[-1] <= "~":
            seq += chr(self.byte())
        params, final = seq[:-1], seq[-1]
        if params.startswith("<") and final in "Mm":
            button, x, y = (int(n) for n in params[1:].split(";"))
            return ("mouse", button, x - 1, y - 1, final == "M")
        parts = params.split(";")
        if final in "ABCD":
            name = {"A": "up", "B": "down", "C": "right", "D": "left"}[final]
            by_word = len(parts) > 1 and parts[1] in ("3", "5") and final in "CD"  # Alt/Ctrl+arrow
            return "w" + name if by_word else name
        if final in "HF":
            return "home" if final == "H" else "end"
        if final == "Z":
            return "btab"
        if final == "~":
            if parts[0] == "200":
                return ("paste", self.paste())
            return {"1": "home", "7": "home", "4": "end", "8": "end", "3": "delete"}.get(parts[0])
        return None

    def paste(self):
        data = b""
        while not data.endswith(b"\x1b[201~"):
            data += bytes([self.byte()])
        return data[:-6].decode("utf-8", "replace").replace("\r\n", "\n").replace("\r", "\n")


class Field:
    """An editable value: text (wrapped; `multiline` allows newlines), or one
    of `options`. `spots` is where the last draw put it: (row, x, start, end)
    per visual line, start and end being indexes into the text."""

    def __init__(self, name, value, options=None, multiline=False):
        self.name, self.value, self.original = name, value, value
        self.options, self.multiline = options, multiline
        self.pos = len(value) if options is None and name != "description" else 0
        self.spots = []

    @property
    def changed(self):
        if self.name == "labels":
            return set(self.value.split()) != set(self.original.split())
        return self.value != self.original


class Editor:
    def __init__(self, term, issue, state, region, border):
        self.term, self.issue, self.state = term, issue, state
        self.region, self.border = region, border  # (top, left, height, width); fzf's pane border
        labels = issue.get("labels") or []
        self.readonly = grouped(l for l in labels if matches(l, config()["readonly_labels"]))
        status, priority = issue.get("status") or "open", issue.get("priority", 2)
        self.fields = [
            Field("title", issue.get("title") or ""),
            Field("status", status, options=STATUSES if status in STATUSES else [status] + STATUSES),
            Field("priority", priority, options=sorted({0, 1, 2, 3, 4, priority}, key=str)),
            Field("labels", " ".join(grouped(l for l in labels if l not in self.readonly))),
        ]
        for key, _ in TEXT_SECTIONS:  # description always, the others when set
            if key == "description" or issue.get(key):
                self.fields.append(Field(key, issue.get(key) or "", multiline=True))
        self.by_name = {f.name: f for f in self.fields}
        self.focus, self.top, self.follow, self.message = 0, 0, True, ""
        self.overwrite = False  # a second Ctrl-S after a "changed meanwhile" warning

    @property
    def current(self):
        return self.fields[self.focus]

    @property
    def dirty(self):
        return any(f.changed for f in self.fields)

    # Layout and drawing

    def layout(self, width):
        """The document as rows of (x, text, sgr) runs; sets the fields' spots."""
        accent = BOLD + ACCENT
        rows, prefix = [], issue_prefix()
        for f in self.fields:
            f.spots = []

        def key(name, *fields):  # a row label; highlighted while its field has focus
            return (0, name.ljust(KEY_WIDTH - 1), accent if self.current in fields else DIM)

        def text(f, x, sgr="", lead=(), placeholder=""):
            sgrs = [sgr] * len(f.value)
            if f.name == "labels":  # namespaces dimmed, as in the pane
                for m in re.finditer(r"\S+", f.value):
                    for i in range(m.start(), m.start() + m.group().find(":") + 1):
                        sgrs[i] = DIM
            for i, (start, end) in enumerate(wrap_segments(f.value, max(width - x - 1, 10))):
                row, j = list(lead) if i == 0 else [], start
                while j < end:  # runs of equal attributes
                    k = j
                    while k < end and sgrs[k] == sgrs[j]:
                        k += 1
                    row.append((x + j - start, f.value[j:k], sgrs[j]))
                    j = k
                f.spots.append((len(rows), x, start, end))
                rows.append(row)
            if not f.value and placeholder and f is not self.current:
                rows[-1].append((x, placeholder, DIM))

        title, status, priority = self.by_name["title"], self.by_name["status"], self.by_name["priority"]
        text(title, 0, BOLD, placeholder="Title")
        rows += [[(0, self.issue.get("id", ""), DIM)], []]
        row, x = [key("status", status, priority)], KEY_WIDTH
        for f, shown in ((status, status_text(status.value)), (priority, priority_text(priority.value))):
            size = visible_len(shown)
            row.append((x, shown, REVERSE if f is self.current else ""))
            f.spots.append((len(rows), x, 0, size))
            x += size + 3
        row.append((x, self.issue.get("issue_type", ""), DIM))
        if self.issue.get("assignee"):
            row.append((x + len(self.issue.get("issue_type", "")) + 3, "@" + self.issue["assignee"], ""))
        rows.append(row)
        for name, value in relation_rows(self.issue, max(width - KEY_WIDTH, 20), prefix):
            rows.append([key(name), (KEY_WIDTH, value, "")])
        labels = self.by_name["labels"]
        text(labels, KEY_WIDTH, lead=[key("labels", labels)], placeholder="none")
        if self.readonly:
            rows.append([(KEY_WIDTH, "  ".join(self.readonly) + "  (read-only)", DIM)])
        for name, heading in TEXT_SECTIONS:
            if name in self.by_name:
                rows.append([])
                if heading:
                    rows.append([(0, heading, accent)])
                text(self.by_name[name], 0, placeholder="Description" if name == "description" else "")
        return rows

    def footer(self):
        f = self.current
        if f.name == "status":
            hint = "←/→ or o i b d c change"
        elif f.name == "priority":
            hint = "←/→ or 0-4 change"
        elif f.name == "labels":
            hint = "space separates · ctrl-l pick"
        else:
            hint = ("enter new line · " if f.multiline else "") + "ctrl-e $EDITOR"
        return f"{hint} · tab next field · ctrl-s save · esc cancel"

    def cursor(self):
        """The cursor's (row, x) in the document, or None on a choice."""
        f = self.current
        if f.options is not None or not f.spots:
            return None
        row, x, start, _ = f.spots[locate(f.pos, f.spots)]
        return row, x + f.pos - start

    def draw(self, footer=None):
        top, left, height, width = self.region
        rows, body = self.layout(width), height - 1
        cur = self.cursor()
        if self.follow:  # keep the field (the cursor's line) in view
            target = cur[0] if cur else self.current.spots[0][0]
            if target < self.top:
                self.top = target
            elif target >= self.top + body:
                self.top = target - body + 1
        self.top = max(0, min(self.top, len(rows) - body))
        out = ["\x1b[?25l"]
        for y in range(body):
            i = self.top + y
            out.append(f"\x1b[{top + y + 1};{left + 1}H" + clip(join_runs(rows[i]) if i < len(rows) else "", width))
        if footer is None:
            footer = (f"{BOLD}\x1b[31m{self.message}" if self.message else
                      f"{DIM}{'● modified · ' if self.dirty else ''}{self.footer()}")
        out.append(f"\x1b[{top + height};{left + 1}H" + clip(footer, width))
        if self.border and left >= 2:  # fzf's pane border, lit while editing
            out += [f"\x1b[{top + y + 1};{left - 1}H{ACCENT}│{RESET}" for y in range(height)]
        if cur and 0 <= cur[0] - self.top < body:
            out.append(f"\x1b[{top + cur[0] - self.top + 1};{left + min(cur[1], width - 1) + 1}H\x1b[?25h")
        self.term.write("".join(out))

    # Keys

    def run(self):
        """Edit until saved (True) or cancelled (False)."""
        while True:
            self.draw()
            key = self.term.key()
            if key is None:
                continue
            self.message, self.follow = "", True
            if key != "\x13":
                self.overwrite = False
            if isinstance(key, tuple) and key[0] == "mouse":
                self.mouse(*key[1:])
            elif isinstance(key, tuple):
                self.paste(key[1])
            elif key == "\x13":  # ctrl-s
                if self.save():
                    return True
            elif key in ("esc", "\x03"):  # ctrl-c too
                if not self.dirty or self.confirm("Discard your changes? y/n"):
                    return False
            elif key == "\t":
                self.go(self.focus + 1)
            elif key == "btab":
                self.go(self.focus - 1)
            elif self.current.options is not None:
                self.choose(key)
            else:
                self.type(key)

    def go(self, index, pos=None):
        self.focus = index % len(self.fields)
        if pos is not None and self.current.options is None:
            self.current.pos = len(self.current.value) if pos == "end" else pos

    def vertical(self, step):
        """Up or Down: the next visual line, else the next field on another row
        (status and priority share one)."""
        f = self.current
        if f.options is None:
            i = locate(f.pos, f.spots)
            j = i + step
            if 0 <= j < len(f.spots):
                col = f.pos - f.spots[i][2]
                _, _, start, end = f.spots[j]
                wrapped = j + 1 < len(f.spots) and f.spots[j + 1][2] == end
                f.pos = min(start + col, end - 1 if wrapped and end > start else end)
                return
        rows = {spot[0] for spot in f.spots}
        index = self.focus + step
        while 0 <= index < len(self.fields) and rows & {spot[0] for spot in self.fields[index].spots}:
            index += step
        if 0 <= index < len(self.fields):
            self.go(index, 0 if step > 0 else "end")

    def choose(self, key):
        f = self.current
        i = f.options.index(f.value)
        if key in ("right", " "):
            f.value = f.options[(i + 1) % len(f.options)]
        elif key == "left":
            f.value = f.options[(i - 1) % len(f.options)]
        elif key in ("up", "down"):
            self.vertical(-1 if key == "up" else 1)
        elif key in ("\r", "\n"):
            self.go(self.focus + 1)
        elif f.name == "priority" and key in tuple("01234"):
            f.value = int(key)
        elif f.name == "status" and len(key) == 1:
            f.value = next((o for o in f.options if o.startswith(key.lower())), f.value)

    def type(self, key):
        f = self.current
        v, p = f.value, f.pos
        if key in ("\r", "\n"):
            if not f.multiline:
                self.go(self.focus + 1)
                return
            v, p = v[:p] + "\n" + v[p:], p + 1
        elif key in ("\x7f", "\x08"):
            if p:
                v, p = v[:p - 1] + v[p:], p - 1
        elif key in ("delete", "\x04"):
            v = v[:p] + v[p + 1:]
        elif key == "left":
            p = max(p - 1, 0)
        elif key == "right":
            p = min(p + 1, len(v))
        elif key == "wleft":
            while p and not v[p - 1].isalnum():
                p -= 1
            while p and v[p - 1].isalnum():
                p -= 1
        elif key == "wright":
            while p < len(v) and not v[p].isalnum():
                p += 1
            while p < len(v) and v[p].isalnum():
                p += 1
        elif key in ("up", "down"):
            self.vertical(-1 if key == "up" else 1)
            return
        elif key in ("home", "\x01"):
            p = v.rfind("\n", 0, p) + 1
        elif key == "end":
            end = v.find("\n", p)
            p = len(v) if end < 0 else end
        elif key == "\x0b":  # ctrl-k: to the end of the line
            end = v.find("\n", p)
            v = v[:p] + (v[end:] if end >= 0 else "")
        elif key == "\x15":  # ctrl-u: to the start of the line
            start = v.rfind("\n", 0, p) + 1
            v, p = v[:start] + v[p:], start
        elif key == "\x17":  # ctrl-w: the word before
            q = p
            while q and v[q - 1] in " \n":
                q -= 1
            while q and v[q - 1] not in " \n":
                q -= 1
            v, p = v[:q] + v[p:], q
        elif key == "\x05":  # ctrl-e
            self.external(f)
            return
        elif key == "\x0c" and f.name == "labels":  # ctrl-l
            self.pick(f)
            return
        elif len(key) == 1 and key.isprintable():
            v, p = v[:p] + key + v[p:], p + 1
        else:
            return
        f.value, f.pos = v, p

    def paste(self, text):
        f = self.current
        if f.options is not None:
            return
        if not f.multiline:
            text = " ".join(text.split("\n"))
        f.value, f.pos = f.value[:f.pos] + text + f.value[f.pos:], f.pos + len(text)

    def mouse(self, button, x, y, pressed):
        top, left, height, width = self.region
        if button == 64:  # the wheel scrolls; the cursor stays
            self.top, self.follow = max(self.top - 3, 0), False
        elif button == 65:
            self.top, self.follow = self.top + 3, False
        elif button == 0 and pressed and 0 <= x - left < width and 0 <= y - top < height - 1:
            mx, row = x - left, y - top + self.top
            for index, f in enumerate(self.fields):
                for i, (spot_row, fx, start, end) in enumerate(f.spots):
                    if spot_row != row:
                        continue
                    if f.options is not None:
                        if fx <= mx < fx + end:
                            if index == self.focus:  # a click on the focused choice changes it
                                self.choose("right")
                            self.focus = index
                            return
                    elif mx >= fx:
                        wrapped = i + 1 < len(f.spots) and f.spots[i + 1][2] == end
                        self.focus = index
                        f.pos = min(start + mx - fx, end - 1 if wrapped and end > start else end)
                        return

    def confirm(self, question):
        self.draw(footer=f"{BOLD}\x1b[33m{question}")
        return self.term.key() in ("y", "Y")

    def suspended(self, run):
        """Run `run` with the terminal handed back (an editor, fzf)."""
        self.term.stop()
        try:
            return run()
        finally:
            self.term.start()

    def external(self, f):
        """Ctrl-E: edit the field in $VISUAL / $EDITOR."""
        import tempfile
        editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi")
        with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8") as tmp:
            tmp.write(f.value + "\n")
        try:
            if self.suspended(lambda: subprocess.run([*editor, tmp.name])).returncode != 0:
                return
            with open(tmp.name, encoding="utf-8") as fh:
                value = fh.read().rstrip("\n")
        finally:
            os.remove(tmp.name)
        f.value = value if f.multiline else " ".join(value.split())
        f.pos = min(f.pos, len(f.value))

    def pick(self, f):
        """Ctrl-L on the labels: the label picker, over the labels typed so far."""
        picked = self.suspended(lambda: pick_labels(self.issue["id"], f.value.split(), self.state))
        if picked is not None:
            f.value = " ".join(picked)
            f.pos = len(f.value)

    def save(self):
        """Write the changed fields with one `bd update`; False (and a message)
        when bd refuses, so nothing typed is lost."""
        import tempfile
        changed = [f for f in self.fields if f.changed]
        if self.by_name["title"].value.strip() == "":
            self.message = "A bead needs a title."
            return False
        if not changed:
            return True
        self.message = "Saving…"
        self.draw()
        # The bead as it is now: bd would apply an update for a deleted ID to
        # another bead (one whose ID starts with it), and someone (an agent,
        # another view) may have changed a field edited here.
        now = show_issue(self.issue["id"])
        if now is None:
            self.message = f"{self.issue['id']} no longer exists: nothing saved."
            return False
        readonly = config()["readonly_labels"]
        theirs = {name: now.get(name) or "" for name, _ in TEXT_SECTIONS}
        theirs.update(title=now.get("title") or "", status=now.get("status") or "",
                      priority=now.get("priority", 2),
                      labels=sorted(l for l in now.get("labels") or [] if not matches(l, readonly)))
        mine = {f.name: sorted(f.original.split()) if f.name == "labels" else f.original for f in changed}
        clash = [name for name in mine if theirs[name] != mine[name]]
        if clash and not self.overwrite:
            self.overwrite = True
            self.message = f"Changed meanwhile: {', '.join(clash)}. Ctrl-S again overwrites, Esc cancels."
            return False
        args, files = ["update", self.issue["id"]], []

        def from_file(flag, value):  # long text via a file: no argument limits, no quoting
            if not value.strip():  # bd refuses an empty file; an empty value clears
                args.append(flag.replace("-file", "").replace("--body", "--description") + "=")
                return
            with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8") as tmp:
                tmp.write(value)
            files.append(tmp.name)
            args.extend([flag, tmp.name])

        for f in changed:
            if f.name == "title":
                args.append("--title=" + f.value.strip())
            elif f.name == "status":
                args.append("--status=" + f.value)
            elif f.name == "priority":
                args.append(f"--priority={f.value}")
            elif f.name == "labels":
                old, new = set(f.original.split()), {l for l in f.value.split() if not matches(l, readonly)}
                args += [a for l in sorted(new - old) for a in ("--add-label", l)]
                args += [a for l in sorted(old - new) for a in ("--remove-label", l)]
            elif f.name == "description":
                from_file("--body-file", f.value)
            elif f.name == "design":
                from_file("--design-file", f.value)
            elif f.name == "acceptance_criteria":
                args.append("--acceptance=" + f.value)
            elif f.name == "notes":
                args.append("--notes=" + f.value)
        try:
            out = subprocess.run([BD, *args], cwd=ROOT, capture_output=True, text=True, timeout=30)
        finally:
            for path in files:
                os.remove(path)
        if out.returncode != 0:
            self.message = "bd: " + ((out.stderr or out.stdout).strip().splitlines() or ["update failed"])[-1]
            return False
        forget_detail(self.issue["id"])
        # The cache now, while "Saving…" shows: fzf reloads from it at once.
        # A reload that ran bd itself would leave fzf's list empty for a
        # moment, and a key pressed then (Right again) would act on no bead.
        fetch(self.state, fresh=True)
        return True


def edit(bead_id, state):
    """The editor for one bead: in fzf's preview pane when fzf passes its
    place (the pane open), else full screen. Saves with bd on Ctrl-S."""
    issue = show_issue(bead_id)
    if issue is None:
        return
    pane = [os.environ.get(f"FZF_PREVIEW_{k}", "") for k in ("TOP", "LEFT", "LINES", "COLUMNS")]
    in_pane = all(v.isdigit() for v in pane)
    term = Term(over_fzf=in_pane)
    if in_pane:
        region = tuple(int(v) for v in pane)
    else:
        lines, columns = term.size()
        region = (0, 0, lines, min(columns, EDIT_WIDTH))
    term.start()
    try:
        Editor(term, issue, state, region, border=in_pane).run()
    finally:
        term.stop()


def prefetch(state, budget):
    """Cache the detail panes of the view's beads, for up to `budget` seconds;
    drop the ones that are out of date."""
    deadline = time.monotonic() + budget
    issues = {i["id"]: i for i in fetch(state)[1]}
    for issue in issues.values():
        path = detail_path(issue["id"], stamp(issue, issues), preview_width())
        current = detail_path(issue["id"], stamp(issue, issues))  # this version, any width
        for old in glob.glob(glob.escape(detail_path(issue["id"])) + "*"):
            if not old.startswith(current):
                try:
                    os.remove(old)
                except OSError:
                    pass
        if not os.path.exists(path) and time.monotonic() < deadline:
            cached_detail(issue["id"], stamp(issue, issues))


def watch():
    """Refresh the cache, and reload fzf (via --listen) when the view changes."""
    import urllib.request  # only the watcher needs it; slow to import
    url = f"http://127.0.0.1:{os.environ['FZF_PORT']}"
    last = None
    while True:
        time.sleep(REFRESH_SECONDS)
        try:  # exit as soon as fzf is gone, even when nothing changes
            urllib.request.urlopen(url, timeout=3).read()
        except Exception:
            return
        try:
            state = load()
            view = render(state, fresh=True)
        except Exception:
            continue
        digest = hashlib.sha1(view.encode()).hexdigest()
        if digest != last:
            # The header too: render may have stepped up out of an emptied focus.
            action = f"transform-header({RUN} header)+reload({RUN} render)+refresh-preview"
            try:
                urllib.request.urlopen(urllib.request.Request(url, data=action.encode(), method="POST"), timeout=3)
            except Exception:
                return  # fzf is gone
            last = digest
        # After the reload, so filling the detail cache never delays (or, if it
        # fails, blocks) an update.
        try:
            prefetch(state, budget=1)
        except Exception:
            pass


RUN = f"{PY} -S {SELF}"  # how fzf's bindings call this script (-S: skip site, faster)


def view():
    # The header changes before the (asynchronous) reload; after it, fzf drops it.
    reload = f"transform-header({RUN} header)+reload({RUN} render)"
    # Edit in the detail pane: shown first (Ctrl-E with it hidden), so fzf
    # passes its place to the editor.
    edit = f"show-preview+execute({RUN} edit {{1}})+reload({RUN} render)"
    args = [
        FZF, "--ansi", "--layout=reverse", "--no-sort", "--track",
        "--delimiter=\t", "--with-nth=5..", "--id-nth=1", "--listen",
        "--no-separator", "--no-scrollbar", "--gutter= ", "--info=hidden", "--prompt=› ",
        "--footer-border=none", "--ellipsis=…",
        "--footer=enter details · → focus/edit · ← parent/up · tab fold · 1-9 levels · 0 unfold · ctrl-e edit · ctrl-l labels · ctrl-a open/all · esc quit",
        # The cached pane when there is one (instant), else bd (and cache it).
        f"--preview=cat {shlex.quote(DETAIL_DIR)}/{{1}}@{{2}}@$FZF_PREVIEW_COLUMNS 2>/dev/null || {RUN} show {{1}} {{2}}",
        "--preview-window=right,50%,wrap-word,border-left,noinfo,hidden",
        "--preview-wrap-sign=",
        f"--bind=start:execute-silent({RUN} watch >/dev/null 2>&1 &)+transform-header({RUN} header)",
        f"--bind=tab:execute-silent({RUN} toggle {{1}})+reload({RUN} render)",
        "--bind=enter:toggle-preview",
        # After every reload (asynchronous): the pane for the row now there, as
        # --track keeps a bead whose stamp (and so its pane) may have changed.
        "--bind=load:refresh-preview",
        f"--bind=double-click:execute-silent({RUN} focus {{1}})+{reload}+first",
        f"--bind=backward-eof:execute-silent({RUN} up)+{reload}",
        f"--bind=ctrl-a:execute-silent({RUN} all)+{reload}",
        f"--bind=ctrl-l:execute({RUN} labels {{1}})+reload({RUN} render)",
        f"--bind=ctrl-e:{edit}",
        "--bind=esc:abort",
    ]
    # While the filter is empty, arrows walk the tree: Right edits the bead while
    # its details show (fzf sets the preview size only then), else focuses a
    # bead with children ({4}) or shows a leaf's details; Left jumps to the parent row
    # ({3}), and from a top row leaves the focus (--track keeps the cursor on
    # the bead just left, so the next Left goes on to its parent). With a
    # filter they move the cursor in it. Digits fold to a level, or are typed
    # (so `12` still finds `.12`). transform: form, as the actions have parentheses.
    args.append(f'--bind=right:transform:if [ -n {{q}} ]; then echo forward-char; '
                f'elif [ -n "$FZF_PREVIEW_COLUMNS" ]; then echo "{edit}"; '
                f'elif [ {{4}} = 1 ]; then echo "execute-silent({RUN} focus {{1}})+{reload}+first"; '
                f'else echo show-preview; fi')
    args.append(f'--bind=left:transform:if [ -n {{q}} ]; then echo backward-char; '
                f'elif [ -n {{3}} ]; then printf "pos(%s)" {{3}}; '
                f'else echo "execute-silent({RUN} up)+{reload}"; fi')
    for n in range(10):
        args.append(f'--bind={n}:transform:[ -z {{q}} ] && echo "execute-silent({RUN} level {n})'
                    f'+reload({RUN} render)" || echo "put({n})"')
    proc = subprocess.run(args, input=render(load(), fresh=True), text=True, cwd=ROOT)
    sys.exit(0 if proc.returncode in (0, 1, 130) else proc.returncode)


def main(argv):
    missing = [name for name, path in (("bd", BD), ("fzf", FZF)) if not path]
    if missing:
        sys.exit(f"beads-view: needs {' and '.join(missing)} on PATH")
    if not argv:
        return view()
    cmd, rest = argv[0], argv[1:]
    state = load()
    if cmd == "render":
        print(render(state, fresh="--fresh" in rest))
    elif cmd == "header":
        print(header(state))
    elif cmd == "show" and rest and rest[0]:
        sys.stdout.write(cached_detail(rest[0], rest[1] if len(rest) > 1 else ""))
    elif cmd == "toggle" and rest:
        state["collapsed"] = sorted(set(state["collapsed"]) ^ {rest[0]})
        save(state)
    elif cmd == "level" and rest and rest[0].isdigit():
        # Show N levels of the current view (level 1 = its top rows): fold every
        # bead at level N or deeper that has children; 0 unfolds the view.
        # Folds of beads outside the view are kept.
        n, rows = int(rest[0]), beads(state)
        in_view = {bead_id for _, bead_id, _ in rows}
        parents = {rows[i][1] for i in range(len(rows) - 1) if rows[i + 1][0] > rows[i][0]}
        folded = {bead_id for depth, bead_id, _ in rows if n and depth >= n - 1 and bead_id in parents}
        state["collapsed"] = sorted((set(state["collapsed"]) - in_view) | folded)
        save(state)
    elif cmd == "focus" and rest:
        # Only a bead with children becomes the view; a leaf (or an empty
        # list's blank row) would leave an empty screen.
        if not rest[0] or not has_children(rest[0], state):
            return
        if not state["stack"] or state["stack"][-1] != rest[0]:
            state["stack"].append(rest[0])
        # A focused bead shows its children, even if it was folded.
        state["collapsed"] = [b for b in state["collapsed"] if b != rest[0]]
        save(state)
    elif cmd == "up":
        if state["stack"]:
            state["stack"].pop()
        save(state)
    elif cmd == "all":
        state["all"] = not state["all"]
        save(state)
    elif cmd in ("labels", "edit"):
        if rest and rest[0]:  # empty while fzf's list (re)loads: nothing to edit
            (edit_labels if cmd == "labels" else edit)(rest[0], state)
    elif cmd == "watch":
        watch()
    else:
        sys.exit(f"beads-view: unknown command {cmd!r}")


if __name__ == "__main__":
    main(sys.argv[1:])
