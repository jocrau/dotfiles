# Match the iTerm2 look
theme = iTerm2 Solarized Dark
font-family = MesloLGS NF
font-size = 12

# Quick terminal: a drop-down scratch shell (outside herdr) over any app.
# The global shortcut needs Accessibility permission for Ghostty (asked once).
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-autohide = true
keybind = global:ctrl+backquote=toggle_quick_terminal

# Left Option stays a normal macOS Option key (umlauts via Option+a/o/u/s).
# Use right Option as Alt for ctrl+alt chords and option+arrow word jumps.
macos-option-as-alt = right
